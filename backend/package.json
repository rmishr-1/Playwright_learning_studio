{
    "name": "studio-backend",
    "private": true,
    "version": "0.1.0",
    "description": "Learning Studio backend - serves imported course content, records learner progress, and executes learner code against a real browser.",
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit"
    },
    "dependencies": {
        "@playwright/test": "1.63.0",
        "express": "^4.21.2",
        "playwright": "1.63.0",
        "typescript": "^5.5.4",
        "typescript-learner": "npm:typescript@^7.0.2",
        "ws": "^8.18.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.14.0",
        "@types/ws": "^8.5.13",
        "tsx": "^4.19.2"
    }
}
