{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playwright-course/day.schema.json",
  "title": "Playwright course — one day of content",
  "description": "Generated by tools/build_json.py from markdown/dayN.md. week1.json = { schemaVersion, week, title, days: [Day…] }.",
  "type": "object",
  "required": ["schemaVersion", "week", "day", "title", "objectives", "sections", "stats"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "week": { "type": "integer" },
    "day": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "estimatedTime": { "type": "string" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "prerequisitesFromEarlierDays": { "type": "array", "items": { "type": "string" } },
    "workspace": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/section" }
    },
    "stats": {
      "type": "object",
      "properties": {
        "lessons": { "type": "integer" },
        "quizzes": { "type": "integer" },
        "exercises": { "type": "integer" },
        "codeBlocks": { "type": "integer" }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "intro", "lessons"],
      "properties": {
        "id": { "enum": ["prerequisites", "fundamentals", "implementation", "practice"] },
        "title": { "type": "string" },
        "intro": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "blocks"],
            "properties": {
              "id": { "type": "string", "description": "d{day}-{sectionId}-{n}" },
              "title": { "type": "string" },
              "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
            }
          }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/markdown" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/terminal" },
        { "$ref": "#/$defs/output" },
        { "$ref": "#/$defs/diagram" },
        { "$ref": "#/$defs/callout" },
        { "$ref": "#/$defs/quiz" },
        { "$ref": "#/$defs/exercise" }
      ]
    },
    "markdown": {
      "type": "object",
      "required": ["type", "content"],
      "properties": { "type": { "const": "markdown" }, "content": { "type": "string", "description": "GitHub-flavoured Markdown" } }
    },
    "code": {
      "type": "object",
      "required": ["type", "language", "content", "mode"],
      "properties": {
        "type": { "const": "code" },
        "language": { "type": "string" },
        "content": { "type": "string" },
        "mode": { "enum": ["read", "editor"], "description": "editor = load into the code editor / Try it" },
        "file": { "type": "string", "description": "path relative to the learner workspace root (pw-course/)" },
        "run": { "type": "string", "description": "terminal command; cwd pw-course/ (ts-basics files: pw-course/ts-basics/)" },
        "expectError": { "type": "boolean", "description": "the sample is meant to fail (type error or failing test)" },
        "network": { "type": "boolean", "description": "needs internet" },
        "expectedOutput": { "type": "string" },
        "expectedOutputTarget": { "enum": ["console", "terminal"] }
      }
    },
    "terminal": {
      "type": "object",
      "required": ["type", "commands"],
      "properties": {
        "type": { "const": "terminal" },
        "shell": { "type": "string" },
        "commands": { "type": "array", "items": { "type": "string" }, "description": "lines starting with # are comments" },
        "cwd": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "required": ["type", "target", "content"],
      "properties": {
        "type": { "const": "output" },
        "target": { "enum": ["console", "terminal"], "description": "console = exact program output; terminal = illustrative" },
        "content": { "type": "string" }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["type", "format", "content"],
      "properties": { "type": { "const": "diagram" }, "format": { "const": "mermaid" }, "content": { "type": "string" } }
    },
    "callout": {
      "type": "object",
      "required": ["type", "variant", "content"],
      "properties": {
        "type": { "const": "callout" },
        "variant": { "enum": ["tip", "note", "warning", "tester", "deepdive", "platform"], "description": "platform = note for platform developers; hide from learners" },
        "title": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "quiz": {
      "type": "object",
      "required": ["type", "id", "quizType", "question", "options", "correct", "explanation"],
      "properties": {
        "type": { "const": "quiz" },
        "id": { "type": "string" },
        "quizType": { "enum": ["single", "multiple", "truefalse"] },
        "question": { "type": "string", "description": "Markdown (inline code allowed)" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
          }
        },
        "correct": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "option ids" },
        "explanation": { "type": "string" },
        "code": { "type": "string" },
        "codeLanguage": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["type", "exerciseType", "id", "title", "level", "prompt"],
      "properties": {
        "type": { "const": "exercise" },
        "exerciseType": { "enum": ["code", "terminal", "written", "predict"] },
        "id": { "type": "string" },
        "title": { "type": "string" },
        "level": { "enum": ["easy", "medium", "hard", "challenge"] },
        "prompt": { "type": "string", "description": "Markdown" },
        "file": { "type": "string" },
        "run": { "type": "string" },
        "starter": { "type": "string" },
        "hints": { "type": "array", "items": { "type": "string" } },
        "solution": { "type": "string" },
        "expectedOutput": { "type": "string" },
        "modelAnswer": { "type": "string", "description": "written exercises" },
        "code": { "type": "string", "description": "predict exercises: code to read" },
        "codeLanguage": { "type": "string" },
        "answer": { "type": "string", "description": "predict exercises: revealed answer" },
        "network": { "type": "boolean" },
        "rubric": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
